      "id": "auto-Digest Cron-0077",
      "name": "Digest Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT COUNT(*) FROM organizations) AS orgs,\n  (SELECT COUNT(*) FROM users) AS users,\n  (SELECT COUNT(*) FROM portfolios) AS portfolios,\n  (SELECT COUNT(*) FROM leads WHERE created_at >= NOW() - INTERVAL '1 day') AS leads_24h,\n  (SELECT COUNT(*) FROM customers WHERE status='active') AS active_customers,\n  (SELECT COALESCE(SUM(amount),0) FROM mrr_events WHERE event_type='subscription.created' AND created_at >= NOW() - INTERVAL '30 days') AS new_mrr_30d,\n  (SELECT COUNT(*) FROM workflows.workflow_executions WHERE created_at >= NOW() - INTERVAL '1 day' AND status='success') AS wf_ok_24h,\n  (SELECT COUNT(*) FROM workflows.workflow_executions WHERE created_at >= NOW() - INTERVAL '1 day' AND status='error') AS wf_fail_24h;",
        "options": {}
      },
      "id": "auto-Collect Digest Metrics-0078",
      "name": "Collect Digest Metrics",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        200,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-main",
          "name": "Quantive DB"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const m = $input.first().json;\nreturn [{ json: {\n  channel: '#daily-digest', severity: 'low',\n  text: `🌅 *Quantive Daily Digest*\nOrgs: ${m.orgs} · Users: ${m.users} · Portfolios: ${m.portfolios}\nLeads 24h: ${m.leads_24h} · Active customers: ${m.active_customers}\nNew MRR 30d: $${Number(m.new_mrr_30d).toFixed(0)}\nWorkflows 24h: ${m.wf_ok_24h} ok / ${m.wf_fail_24h} failed`,\n}}];"
      },
      "id": "auto-Format Digest-0079",
      "name": "Format Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "channel": "={{ $json.channel }}",
        "text": "={{ $json.text }}",
        "otherOptions": {}
      },
      "id": "auto-Post Digest-0080",
      "name": "Post Digest",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [
        600,
        0
      ],
      "credentials": {
        "slackApi": {
          "id": "slack-main",
          "name": "Quantive Slack"
        }
      },
      "onError": "continueRegularOutput"
    },

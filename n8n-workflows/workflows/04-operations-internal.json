        "query": "SELECT ip_address, COUNT(*) AS attempts FROM login_attempts\nWHERE success = FALSE AND attempted_at >= NOW() - INTERVAL '30 minutes'\nGROUP BY ip_address HAVING COUNT(*) >= 5 ORDER BY attempts DESC LIMIT 10;",
        "options": {}
      },
      "id": "auto-Failed Logins 30m-0086",

      "id": "auto-Error Monitor Cron-0081",
      "name": "Error Monitor Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT error_type, message, severity, COUNT(*) AS count\nFROM workflows.workflow_errors\nWHERE created_at >= NOW() - INTERVAL '2 hours'\nGROUP BY error_type, message, severity ORDER BY count DESC LIMIT 10;",
        "options": {}
      },
      "id": "auto-Recent Unresolved Errors-0082",
      "name": "Recent Unresolved Errors",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        200,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-main",
          "name": "Quantive DB"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nif (!rows.length) return [];\nreturn [{ json: {\n  channel: '#platform-alerts', severity: 'high',\n  text: `🚨 *${rows.length} error groups in last 2h*\n` + rows.slice(0, 5).map(r => `• [${r.severity}] ${r.error_type}: ${String(r.message).slice(0, 120)} ×${r.count}`).join('\n'),\n}}];"
      },
      "id": "auto-Gate Error Alert-0083",

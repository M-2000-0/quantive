    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support-ticket",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "auto-Support Ticket Webhook-0092",
      "name": "Support Ticket Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        1200
      ],
      "webhookId": "support-ticket"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst item = $input.first().json;\nconst header = (item.headers && item.headers['x-quantive-signature']) || '';\nconst secret = process.env.QUANTIVE_WEBHOOK_SECRET || '';\nconst raw = JSON.stringify(item.body || {});\nconst expected = crypto.createHmac('sha256', secret).update(raw).digest('hex');\nlet ok = false;\ntry {\n  const a = Buffer.from(header, 'hex'); const b = Buffer.from(expected, 'hex');\n  ok = a.length === b.length && a.length > 0 && crypto.timingSafeEqual(a, b);\n} catch (e) { ok = false; }\nif (!ok) throw new Error('Invalid HMAC signature');\nreturn [{ json: item.body }];"
      },
      "id": "auto-Verify Support HMAC-0093",
      "name": "Verify Support HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        1200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO support_tickets (subject, description, priority, status, customer_email)\nVALUES ('{{ $json.subject }}', '{{ $json.description || \"\" }}', '{{ $json.priority || \"medium\" }}', 'open', '{{ $json.customer_email || \"\" }}') RETURNING id;",
        "options": {}
      },
      "id": "auto-Insert Support Ticket-0094",
      "name": "Insert Support Ticket",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        400,
        1200
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-main",
          "name": "Quantive DB"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const t = $input.first().json;\nconst sev = t.priority === 'urgent' ? 'critical' : t.priority === 'high' ? 'high' : 'medium';\nreturn [{ json: {\n  channel: sev === 'critical' ? '#support-alerts' : '#customer-success',\n  severity: sev,\n  ticket_id: t.id,\n  text: `🎫 *New ticket #${t.id}* (${t.priority || 'medium'})\n${t.subject}\nfrom: ${t.customer_email || 'unknown'}`,\n}}];"
      },
      "id": "auto-Route Ticket-0095",
      "name": "Route Ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

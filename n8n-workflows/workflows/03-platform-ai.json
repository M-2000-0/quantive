{
  "id": "wf3-platform-ai",
  "name": "WF-3: Quantive Platform & AI",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/30 * * * *"
            }
          ]
        }
      },
      "id": "auto-Market Data Cron-0056",
      "name": "Market Data Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const symbols = [\n  { symbol: '^TNX', name: 'US 10Y Treasury Yield' },\n  { symbol: 'DX-Y.NYB', name: 'US Dollar Index' },\n  { symbol: 'GC=F', name: 'Gold Futures' },\n  { symbol: 'CL=F', name: 'WTI Crude' },\n  { symbol: '^GSPC', name: 'S&P 500' },\n  { symbol: '^VIX', name: 'VIX' },\n  { symbol: 'BTC-USD', name: 'Bitcoin' },\n  { symbol: 'ETH-USD', name: 'Ethereum' },\n];\nreturn symbols.map(s => ({ json: s }));"
      },
      "id": "auto-Build Symbol List-0057",
      "name": "Build Symbol List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://query1.finance.yahoo.com/v8/finance/chart/{{ $json.symbol }}",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "range",
              "value": "1d"
            },
            {
              "name": "interval",
              "value": "1h"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Quantive-n8n)"
            }
          ]
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 3000,
        "onError": "continueRegularOutput"
      },
      "id": "auto-Yahoo Finance Quote-0058",
      "name": "Yahoo Finance Quote",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst chart = item.chart && item.chart.result && item.chart.result[0];\nif (!chart || !chart.meta || chart.meta.regularMarketPrice === undefined) return [];\nreturn [{ json: {\n  symbol: chart.meta.symbol,\n  name: $('Build Symbol List').first().json.name,\n  value: chart.meta.regularMarketPrice,\n  source: 'yahoo_finance',\n  timestamp: new Date((chart.meta.regularMarketTime || Date.now() / 1000) * 1000).toISOString(),\n}}];"
      },
      "id": "auto-Parse Yahoo Response-0059",
      "name": "Parse Yahoo Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO market_data (symbol, name, value, source, timestamp)\nVALUES ('{{ $json.symbol }}', '{{ $json.name }}', {{ $json.value }}, '{{ $json.source }}', '{{ $json.timestamp }}');",
        "options": {}
      },
      "id": "auto-Store Market Data-0060",
      "name": "Store Market Data",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        800,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-main",
          "name": "Quantive DB"
        }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * *"
            }
          ]
        }
      },
      "id": "auto-News Cron-0061",
      "name": "News Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://newsapi.org/v2/top-headlines",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "category",
              "value": "business"
            },
            {
              "name": "language",
              "value": "en"
            },
            {
              "name": "pageSize",
              "value": "30"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 5000,
        "onError": "continueRegularOutput"
      },
      "id": "auto-Fetch Market News-0062",
      "name": "Fetch Market News",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r.articles) return [];\nreturn r.articles\n  .filter(a => a.title && a.url)\n  .map(a => ({ json: {\n    title: a.title, description: a.description || '', url: a.url,\n    source: (a.source && a.source.name) || '', published_at: a.publishedAt,\n  }}));"
      },
      "id": "auto-Normalize News-0063",
      "name": "Normalize News",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO news_articles (title, description, url, source, published_at)\nVALUES ('{{ $json.title.replace(/'/g, \"\") }}', '{{ ($json.description || \"\").replace(/'/g, \"\") }}', '{{ $json.url }}', '{{ $json.source }}', '{{ $json.published_at }}')\nON CONFLICT (url) DO NOTHING;",
        "options": {}
      },
      "id": "auto-Insert News Article-0064",
      "name": "Insert News Article",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        600,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-main",
          "name": "Quantive DB"
        }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1-5"
            }
          ]
        }
      },
      "id": "auto-AI Summary Cron-0065",
      "name": "AI Summary Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        600
      ]
    },
    {
      "parameters": {
        "url": "https://api.openai.com/v1/chat/completions",
        "options": {},
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'gpt-4o-mini',\n  messages: [\n    { role: 'system', content: 'You are a sovereign-debt market analyst. Summarize todays market conditions in 5 bullet points, max 120 words.' },\n    { role: 'user', content: 'Rates, dollar, gold, oil, equities, VIX, crypto — what matters for treasury desks today?' }\n  ],\n  temperature: 0.3,\n}) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "retryOnFail": true,
        "maxTries": 2,
        "waitBetweenTries": 3000,
        "onError": "continueRegularOutput"
      },
      "id": "auto-OpenAI Market Summary-0066",
      "name": "OpenAI Market Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst text = r.choices && r.choices[0] && r.choices[0].message && r.choices[0].message.content || '';\nif (!text) return [];\nreturn [{ json: { summary: text.trim(), generated_at: new Date().toISOString() }}];"
      },
      "id": "auto-Extract Summary-0067",
      "name": "Extract Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        600
      ]
    },
    {
      "parameters": {
        "channel": "#market-news",
        "text": "📈 *Daily Market Summary* (AI)\n{{ $json.summary }}",
        "otherOptions": {}
      },
      "id": "auto-Market Summary → Slack-0068",
      "name": "Market Summary → Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [
        600,
        600
      ],
      "credentials": {
        "slackApi": {
          "id": "slack-main",
          "name": "Quantive Slack"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "id": "auto-Health Cron-0069",
      "name": "Health Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        900
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.QUANTIVE_BASE_URL || 'http://127.0.0.1:8000' }}/api/optimize-debt/status",
        "options": {},
        "retryOnFail": true,
        "maxTries": 2,
        "waitBetweenTries": 2000,
        "onError": "continueRegularOutput"
      },
      "id": "auto-Ping Backend Status-0070",
      "name": "Ping Backend Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        900
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst healthy = r && r.status === 'operational';\nreturn [{ json: {\n  service: 'quantive-backend',\n  status: healthy ? 'healthy' : 'unhealthy',\n  status_code: healthy ? 200 : 503,\n  response_time_ms: 0,\n}}];"
      },
      "id": "auto-Evaluate Health-0071",
      "name": "Evaluate Health",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        900
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO api_health_checks (service, status_code, response_time_ms, status)\nVALUES ('{{ $json.service }}', {{ $json.status_code }}, {{ $json.response_time_ms }}, '{{ $json.status }}');",
        "options": {}
      },
      "id": "auto-Insert Health Check-0072",
      "name": "Insert Health Check",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        600,
        900
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-main",
          "name": "Quantive DB"
        }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * *"
            }
          ]
        }
      },
      "id": "auto-Metrics Cron-0073",
      "name": "Metrics Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        1200
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.QUANTIVE_BASE_URL || 'http://127.0.0.1:8000' }}/api/v1/digest",
        "options": {},
        "retryOnFail": true,
        "maxTries": 2,
        "waitBetweenTries": 3000,
        "onError": "continueRegularOutput"
      },
      "id": "auto-Fetch App Digest-0074",
      "name": "Fetch App Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        1200
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nreturn [{ json: { snapshot: JSON.stringify(d).slice(0, 4000), fetched_at: new Date().toISOString() }}];"
      },
      "id": "auto-Shape Digest-0075",
      "name": "Shape Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        1200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO market_data (symbol, name, value, source, timestamp)\nVALUES ('QUANTIVE_DIGEST', 'App digest snapshot', 0, 'quantive_backend', NOW());",
        "options": {}
      },
      "id": "auto-Store Digest Snapshot-0076",
      "name": "Store Digest Snapshot",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        600,
        1200
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-main",
          "name": "Quantive DB"
        }
      }
    }
  ],

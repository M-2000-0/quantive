{
  "name": "SVC-1: Lead Enrichment (manual)",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "auto-Manual-0000",
      "name": "Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nreturn items.map(it => ({ json: {\n  lead_id: it.id || it.lead_id || '',\n  email: it.email || '',\n  domain: (it.email || '').split('@')[1] || (it.company || '').toLowerCase().replace(/[^a-z0-9-]/g, '') + '.com',\n  company: it.company || '',\n}}));"
      },
      "id": "auto-Build Enrich Queries-0001",
      "name": "Build Enrich Queries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://company.clearbit.com/v2/companies/find",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "domain",
              "value": "={{ $json.domain }}"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth"
      },
      "id": "auto-Fetch Company Data (Clearbit)-0002",
      "name": "Fetch Company Data (Clearbit)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        400,
        0
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const src = $input.first().json;\nreturn [{ json: {\n  lead_id: src.lead_id || src.id || '',\n  email: src.email || '',\n  company_size: src.metrics && src.metrics.employees ? String(src.metrics.employees) : null,\n  industry: (src.category && src.category.sector) || null,\n  location: [src.geo && src.geo.city, src.geo && src.geo.country].filter(Boolean).join(', ') || null,\n  enriched_data: src,\n}}];"
      },
      "id": "auto-Map Enrichment-0003",
      "name": "Map Enrichment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ]
    }
  ],
  "connections": {
    "Manual": {
      "main": [
        [
          {
            "node": "Build Enrich Queries",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Enrich Queries": {

            "index": 0
          }
        ]
      ]
    },
    "Fetch Company Data (Clearbit)": {
      "main": [
        [
          {
            "node": "Map Enrichment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },

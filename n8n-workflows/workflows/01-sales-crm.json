    {
      "parameters": {
        "url": "https://company.clearbit.com/v2/companies/find",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "domain",
              "value": "={{ $json.domain }}"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "retryOnFail": true,
        "maxTries": 2,
        "waitBetweenTries": 2000,
        "onError": "continueRegularOutput"
      },
      "id": "auto-Clearbit Company Lookup-0019",
      "name": "Clearbit Company Lookup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Upsert Lead').first().json;\nconst src = $input.first().json || {};\nconst enriched = {\n  ...lead,\n  company_size: src.metrics && src.metrics.employees ? String(src.metrics.employees) : null,\n  industry: (src.category && src.category.sector) || null,\n  location: [src.geo && src.geo.city, src.geo && src.geo.country].filter(Boolean).join(', ') || null,\n};\nlet score = 0;\nconst size = enriched.company_size ? parseInt(enriched.company_size, 10) : 0;\nif (size > 500) score += 40; else if (size > 50) score += 25; else if (size > 0) score += 10;\nif (['financial services','banking','government','insurance'].some(k => (enriched.industry||'').toLowerCase().includes(k))) score += 30;\nif ((enriched.email||'').endsWith('.gov')) score += 20;\nconst tier = score >= 70 ? 'hot' : score >= 40 ? 'warm' : 'cold';\nreturn [{ json: { ...enriched, score, tier }}];"
      },
      "id": "auto-Merge Enrichment + Score-0020",
      "name": "Merge Enrichment + Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads SET score={{ $json.score }}, tier='{{ $json.tier }}',\n  company_size='{{ $json.company_size || \"\" }}', industry='{{ $json.industry || \"\" }}', location='{{ $json.location || \"\" }}',\n  enriched_data='{{ JSON.stringify($json) }}'::jsonb, updated_at=NOW()\nWHERE email='{{ $json.email }}';",
        "options": {}
      },
      "id": "auto-Update Lead Score-0021",
      "name": "Update Lead Score",
      "type": "n8n-nodes-base.postgres",

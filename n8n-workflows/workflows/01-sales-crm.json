    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst item = $input.first().json;\nconst header = (item.headers && item.headers['x-quantive-signature']) || '';\nconst secret = process.env.QUANTIVE_WEBHOOK_SECRET || '';\nconst raw = JSON.stringify(item.body || {});\nconst expected = crypto.createHmac('sha256', secret).update(raw).digest('hex');\nlet ok = false;\ntry {\n  const a = Buffer.from(header, 'hex'); const b = Buffer.from(expected, 'hex');\n  ok = a.length === b.length && a.length > 0 && crypto.timingSafeEqual(a, b);\n} catch (e) { ok = false; }\nif (!ok) throw new Error('Invalid HMAC signature');\nreturn [{ json: item.body }];"
      },
      "id": "auto-Verify Lead HMAC-0016",
      "name": "Verify Lead HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO leads (email, name, company, source, status, created_at, updated_at)\nVALUES ('{{ $json.email }}', '{{ $json.name }}', '{{ $json.company }}', '{{ $json.source }}', 'new', NOW(), NOW())\nON CONFLICT (email) DO UPDATE SET name=EXCLUDED.name, company=EXCLUDED.company, updated_at=NOW()\nRETURNING id, email, name, company, score, tier, status;",
        "options": {}
      },
      "id": "auto-Upsert Lead-0017",
      "name": "Upsert Lead",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        400,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-main",
          "name": "Quantive DB"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const lead = $input.first().json;\nreturn [{ json: {\n  email: lead.email, name: lead.name, company: lead.company,\n  domain: (lead.email || '').split('@')[1] || '',\n}}];"
      },
      "id": "auto-Build Enrichment Query-0018",
      "name": "Build Enrichment Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0

{
  "id": "wf2-billing-lifecycle",
  "name": "WF-2: Billing & Customer Lifecycle",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "events": [
          "*"
        ]
      },
      "id": "auto-Stripe Trigger-0041",
      "name": "Stripe Trigger",
      "type": "n8n-nodes-base.stripeTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const ev = $input.first().json;\nconst type = ev.type || 'unknown';\nconst obj = ev.data && ev.data.object ? ev.data.object : ev;\nreturn [{ json: { type, obj, customer: obj.customer || null }}];"
      },
      "id": "auto-Route by Event Type-0042",
      "name": "Route by Event Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.type}}",
                    "rightValue": "customer.subscription.created",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": "Sub Created"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.type}}",
                    "rightValue": "customer.subscription.updated",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": "Sub Updated"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.type}}",
                    "rightValue": "invoice.payment_failed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": "Payment Failed"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.type}}",
                    "rightValue": "customer.subscription.deleted",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": "Churn"
            }
          ]
        }
      },
      "id": "auto-Switch Event-0043",
      "name": "Switch Event",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO customers (stripe_customer_id, plan, status, created_at, updated_at)\nVALUES ('{{ $json.customer }}', '{{ $json.obj.metadata.tier || \"starter\" }}', 'active', NOW(), NOW())\nON CONFLICT (stripe_customer_id) DO UPDATE SET status='active', plan=EXCLUDED.plan, updated_at=NOW();",
        "options": {}
      },
      "id": "auto-Upsert Customer on Create-0044",
      "name": "Upsert Customer on Create",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        600,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-main",
          "name": "Quantive DB"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO mrr_events (customer_id, amount, event_type)\nSELECT id, COALESCE({{ $json.obj.items && $json.obj.items.data && $json.obj.items.data[0] && $json.obj.items.data[0].price ? $json.obj.items.data[0].price.unit_amount : 0 }}/100.0, 0), 'subscription.created'\nFROM customers WHERE stripe_customer_id='{{ $json.customer }}';",
        "options": {}
      },
      "id": "auto-Log MRR on Create-0045",
      "name": "Log MRR on Create",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        800,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-main",
          "name": "Quantive DB"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE customers SET plan='{{ $json.obj.metadata.tier || \"pro\" }}', updated_at=NOW() WHERE stripe_customer_id='{{ $json.customer }}';",
        "options": {}
      },
      "id": "auto-Update Plan on Change-0046",
      "name": "Update Plan on Change",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        600,
        150
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-main",
          "name": "Quantive DB"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO invoice_events (stripe_customer_id, event_type, amount, status)\nVALUES ('{{ $json.customer }}', 'invoice.payment_failed', COALESCE({{ $json.obj.amount_due || 0 }}/100.0, 0), 'failed');",
        "options": {}
      },
      "id": "auto-Log Payment Failure-0047",
      "name": "Log Payment Failure",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        600,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-main",
          "name": "Quantive DB"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE customers SET subscription_status='past_due', updated_at=NOW() WHERE stripe_customer_id='{{ $json.customer }}';",
        "options": {}
      },
      "id": "auto-Mark Customer Past Due-0048",
      "name": "Mark Customer Past Due",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        800,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-main",
          "name": "Quantive DB"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE customers SET status='churned', subscription_status='canceled', churned_at=NOW() WHERE stripe_customer_id='{{ $json.customer }}';",
        "options": {}
      },
      "id": "auto-Mark Churned-0049",
      "name": "Mark Churned",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        600,
        450
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-main",
          "name": "Quantive DB"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.QUANTIVE_BASE_URL || 'http://127.0.0.1:8000' }}/api/billing/webhook",
        "options": {},
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: $json.type, data: { object: $json.obj } }) }}",
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 3000,
        "onError": "continueRegularOutput"
      },
      "id": "auto-Relay to Quantive Backend-0050",
      "name": "Relay to Quantive Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        600
      ]
    },
    {
      "parameters": {
        "channel": "#billing-events",
        "text": "💳 *{{ $json.type }}*\ncustomer: {{ $json.customer }}",
        "otherOptions": {}
      },
      "id": "auto-Billing Event → Slack-0051",
      "name": "Billing Event → Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [
        800,
        600
      ],
      "credentials": {
        "slackApi": {
          "id": "slack-main",
          "name": "Quantive Slack"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      },
      "id": "auto-Re-engagement Cron-0052",
      "name": "Re-engagement Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        900
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, email, name FROM customers\nWHERE status='active' AND last_active_at < NOW() - INTERVAL '30 days' AND reengagement_sent = FALSE\nLIMIT 50;",
        "options": {}
      },
      "id": "auto-Find Inactive Customers-0053",
      "name": "Find Inactive Customers",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        200,
        900
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-main",
          "name": "Quantive DB"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "quantive@quantive.com",
        "toEmail": "={{ $json.email }}",
        "subject": "We miss you — new in Quantive",
        "emailFormat": "text",
        "text": "Hi {{ $json.name || \"there\" }},\n\nIt's been a while since you used Quantive. New: market monitor, bubble detection, and a faster optimization engine.\n\nLog back in and take a look.\n\n— The Quantive Team",
        "options": {}
      },
      "id": "auto-Re-engagement Email-0054",
      "name": "Re-engagement Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        400,
        900
      ],
      "credentials": {
        "smtp": {
          "id": "smtp-main",
          "name": "Quantive SMTP"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE customers SET reengagement_sent = TRUE WHERE id = '{{ $json.id }}';",
        "options": {}
      },
      "id": "auto-Mark Re-engagement Sent-0055",
      "name": "Mark Re-engagement Sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        600,
        900
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-main",
          "name": "Quantive DB"
        }
      }
    }
  ],
  "connections": {

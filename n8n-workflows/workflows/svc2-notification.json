{
  "id": "svc2-notification",
  "name": "SVC-2: Notification Service (manual)",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "auto-Manual-0000",
      "name": "Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const it = $input.first().json;\nreturn [{ json: {\n  channel: it.channel || '#workflow-logs',\n  severity: it.severity || 'low',\n  text: it.text || String(it.message || JSON.stringify(it)).slice(0, 500),\n}}];"
      },
      "id": "auto-Normalize Notification-0004",
      "name": "Normalize Notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "channel": "={{ $json.channel }}",
        "text": "={{ $json.text }}",
        "otherOptions": {}
      },
      "id": "auto-Post to Slack-0005",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [
        400,
        0
      ],
      "credentials": {
        "slackApi": {
          "id": "slack-main",
          "name": "Quantive Slack"
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Manual": {
      "main": [
        [
          {
            "node": "Normalize Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Notification": {
      "main": [
        [
          {
            "node": "Post to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "wf0-error-handler"
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "pinData": {},
  "versionId": null,
  "tags": [
    "service",
    "notification"
  ],
  "description": "Notification service: posts a formatted message to a Slack channel via the native Slack node."
}
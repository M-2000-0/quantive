# Quantive n8n Workflows — Environment Variables (v2 node-based architecture)

# ── Quantive backend ──
# Base URL of the running FastAPI app that n8n calls (health checks,
# digest polling, Stripe webhook relay).
QUANTIVE_BASE_URL=http://127.0.0.1:8000

# HMAC secret for internal webhooks (lead-capture, demo-booked,
# deal-closed, deal-stage, support-ticket). Callers must send
# x-quantive-signature: HMAC_SHA256(secret, JSON.stringify(body)) as hex.
QUANTIVE_WEBHOOK_SECRET=change-me
# Copy this to .env and fill in real values before activating workflows.

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
DB_HOST=quantive-db
DB_PORT=5432
DB_USER=quantive
DB_PASSWORD=changeme_in_production
DB_NAME=quantive
DATABASE_URL=postgresql://quantive:changeme_in_production@quantive-db:5432/quantive

# ============================================================
# WEBHOOK SECRETS (generate with: openssl rand -hex 32)
# ============================================================
WEBHOOK_SECRET=generate_a_random_hex_string_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ============================================================
# SLACK
# ============================================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_SALES=#sales-alerts
SLACK_CHANNEL_TEAM=#team
SLACK_CHANNEL_METRICS=#metrics
SLACK_CHANNEL_OPS=#ops-alerts
SLACK_CHANNEL_SECURITY=#security
SLACK_CHANNEL_SUPPORT=#support
SLACK_CHANNEL_NEWS=#news-feed
SLACK_CHANNEL_MODELS=#model-alerts
SLACK_CHANNEL_CONTRACTS=#contracts
SLACK_CHANNEL_TASKS=#tasks
SLACK_CHANNEL_INCIDENTS=#incidents

# ============================================================
# EMAIL (SMTP)
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@quantive.com
SMTP_PASS=your_smtp_password
SMTP_FROM_SALES=sales@quantive.com
SMTP_FROM_BILLING=billing@quantive.com
SMTP_FROM_ONBOARDING=onboarding@quantive.com
SMTP_FROM_MARKET=market@quantive.com
SMTP_FROM_TEAM=team@quantive.com
SMTP_FROM_PLATFORM=platform@quantive.com

# ============================================================
# EXTERNAL APIs
# ============================================================
FRED_API_KEY=your_fred_api_key
NEWS_API_KEY=your_newsapi_key
CLEARBIT_API_KEY=your_clearbit_api_key
OPENAI_API_KEY=sk-your_openai_key

# ============================================================
# APP CONFIGURATION
# ============================================================
BASE_URL=https://app.quantive.com
N8N_WEBHOOK_URL=https://n8n.quantive.com
ENVIRONMENT=production

# ============================================================
# STRIPE
# ============================================================
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

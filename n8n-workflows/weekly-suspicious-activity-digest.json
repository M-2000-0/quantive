{"name":"Quantive: Weekly Suspicious Activity Digest","nodes":[{"parameters":{"rule":{"interval":1}},"id":"schedule","name":"Weekly Monday 8AM","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1,"position":[250,300]},{"parameters":{"url":"http://localhost:4000/api/v1/auth/login","sendBody":true,"bodyParameters":{"parameters":[{"name":"email","value":"={{$parameter.quantiveEmail}}"},{"name":"password","value":"={{$parameter.quantivePassword}}"}],"options":{}},"options":{}},"id":"login","name":"Quantive Login","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[450,300]},{"parameters":{"url":"http://localhost:4000/api/v1/alerts","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"=Bearer {{$json.data.accessToken}}"}],"options":{}},"options":{}},"id":"alerts","name":"Get All Alerts","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[650,300]},{"parameters":{"url":"http://localhost:4000/api/v1/cases","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"=Bearer {{$json.data.accessToken}}"}],"options":{}},"options":{}},"id":"cases","name":"Get All Cases","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[650,450]},{"parameters":{"jsCode":"const alerts=$input.all()[0].json.data||[];const cases=$input.all()[1].json.data||[];const openAlerts=alerts.filter(a=>a.status==='OPEN');const criticalAlerts=openAlerts.filter(a=>a.severity==='CRITICAL');const openCases=cases.filter(c=>c.status!=='CLOSED'&&c.status!=='DISMISSED');return[{json:{reportDate:new Date().toISOString().slice(0,10),totalAlerts:alerts.length,openAlerts:openAlerts.length,criticalAlerts:criticalAlerts.length,highAlerts:openAlerts.filter(a=>a.severity==='HIGH').length,openCases:openCases.length,criticalCases:openCases.filter(c=>c.riskLevel==='CRITICAL').length,recentCritical:criticalAlerts.slice(0,10).map(a=>({id:a.id,title:a.title,reason:a.reasonCode,created:a.createdAt})),activeCases:openCases.slice(0,10).map(c=>({id:c.id,title:c.title,priority:c.priority,status:c.status}))}}]"},"id":"build","name":"Build Digest","type":"n8n-nodes-base.code","typeVersion":2,"position":[850,300]},{"parameters":{"fromEmail":"quantive@localhost","toEmail":"={{$parameter.toEmail}}","subject":"=Weekly Suspicious Activity Digest — {{$json.reportDate}}","text":"=📊 WEEKLY SUSPICIOUS ACTIVITY DIGEST\nDate: {{$json.reportDate}}\n\n=== SUMMARY ===\nTotal Alerts (weekly): {{$json.totalAlerts}}\nOpen Alerts: {{$json.openAlerts}} (Critical: {{$json.criticalAlerts}}, High: {{$json.highAlerts}})\nActive Cases: {{$json.openCases}} (Critical: {{$json.criticalCases}})\n\n=== RECENT CRITICAL ALERTS ===\n{{$json.recentCritical.map(a=>'• ['+a.created.slice(0,10)+'] '+a.title+' — '+a.reason).join('\\n')}}\n\n=== ACTIVE CASES ===\n{{$json.activeCases.map(c=>'• ['+c.status+'] '+c.title+' ('+c.priority+')').join('\\n')}}\n\nView: http://localhost:3000","options":{}},"id":"email","name":"Send Digest","type":"n8n-nodes-base.emailSend","typeVersion":1,"position":[1050,300]}],"connections":{"Weekly Monday 8AM":{"main":[[{"node":"Quantive Login","type":"main","index":0}]]},"Quantive Login":{"main":[[{"node":"Get All Alerts","type":"main","index":0},{"node":"Get All Cases","type":"main","index":0}]]},"Get All Alerts":{"main":[[{"node":"Build Digest","type":"main","index":0}]]},"Get All Cases":{"main":[[{"node":"Build Digest","type":"main","index":0}]]},"Build Digest":{"main":[[{"node":"Send Digest","type":"main","index":0}]]}}}
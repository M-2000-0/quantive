{"name":"Quantive: Daily Compliance Digest","nodes":[{"parameters":{"rule":{"interval":1}},"id":"schedule","name":"Daily at 9AM","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1,"position":[250,300]},{"parameters":{"url":"http://localhost:4000/api/v1/auth/login","sendBody":true,"bodyParameters":{"parameters":[{"name":"email","value":"={{$parameter.quantiveEmail}}"},{"name":"password","value":"={{$parameter.quantivePassword}}"}],"options":{}},"options":{}},"id":"login","name":"Quantive Login","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[450,300]},{"parameters":{"url":"http://localhost:4000/api/v1/admin/dashboard","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"=Bearer {{$json.data.accessToken}}"}],"options":{}},"options":{}},"id":"get-dash","name":"Get Dashboard","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[650,300]},{"parameters":{"url":"http://localhost:4000/api/v1/alerts","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"=Bearer {{$json.data.accessToken}}"}],"options":{}},"options":{}},"id":"get-alerts","name":"Get Open Alerts","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[650,450]},{"parameters":{"url":"http://localhost:4000/api/v1/cases","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"=Bearer {{$json.data.accessToken}}"}],"options":{}},"options":{}},"id":"get-cases","name":"Get Active Cases","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[650,600]},{"parameters":{"jsCode":"const dash=$input.all()[0].json.data;const alerts=$input.all()[1].json.data||[];const cases=$input.all()[2].json.data||[];const openAlerts=alerts.filter(a=>a.status==='OPEN'
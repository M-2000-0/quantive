# Quantive Environment Configuration
# Copy this file to .env and adjust values for your deployment

# === CORS (Cross-Origin Resource Sharing) ===
# Origins allowed to access the API
# - For development: ["*"] allows all origins
# - For production: specify exact origins, e.g., "https://example.com,https://app.example.com"
QUANTIVE_CORS_ORIGINS="*"

# HTTP methods allowed
# - Standard: "GET,POST,PUT,DELETE,OPTIONS"
QUANTIVE_CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"

# HTTP headers allowed
# - Standard: "Authorization,Content-Type"
QUANTIVE_CORS_HEADERS="Authorization,Content-Type"

# === Job Management ===
# Default timeout for async optimization jobs (seconds)
# Jobs running longer than this will be cancelled
QUANTIVE_JOB_TIMEOUT="300"

# Maximum number of worker processes for async job execution
QUANTIVE_MAX_WORKERS="4"

# === Server ===
# Environment: "development" or "production"
QUANTIVE_ENV="development"

# === Optional: Other Settings ===
# API version prefix (e.g., "/api/v1")
# QUANTIVE_API_PREFIX=""

# === Database (if using persistent state) ===
# Uncomment and configure if using Redis/SQLite backend
# QUANTIVE_REDIS_URL="redis://localhost:6379/0"
# QUANTIVE_SQLITE_PATH="quantive.db"

# === Stripe Billing (SERVER-SIDE ONLY) ===
# Secret key — backend use ONLY (app/billing.py). Never expose to the browser,
# never embed in templates/frontend bundles, never pass a pk_ key here.
# Local placeholder: sk_test_YOUR_SECRET_KEY   Production: sk_live_...
STRIPE_SECRET_KEY=""

# Webhook signing secret for POST /api/billing/webhook (Stripe dashboard →
# Developers → Webhooks). Server-side only.
# Local placeholder: whsec_YOUR_WEBHOOK_SECRET
STRIPE_WEBHOOK_SECRET=""

# Price IDs created in the Stripe dashboard (Products → Pricing), not keys.
STRIPE_PRO_MONTHLY_PRICE_ID=""
STRIPE_PRO_YEARLY_PRICE_ID=""
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=""
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=""

# Publishable key — FRONTEND/CLIENT-SIDE ONLY (e.g. Stripe.js:
# Stripe('pk_test_YOUR_PUBLISHABLE_KEY')). Never used in backend code; the
# redirect-based Checkout on /billing needs only the secret key above.
# Local placeholder: pk_test_YOUR_PUBLISHABLE_KEY   Production: pk_live_...
STRIPE_PUBLISHABLE_KEY=""
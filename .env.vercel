# ── Vercel Deployment Environment Variables ──────────────────────────
# Copy these into your Vercel project settings (Settings → Environment Variables)

# ── Backend (FastAPI on Vercel) ─────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-64-char-string

# PostgreSQL (use Vercel Postgres, Neon, or Supabase — Transaction mode required)
# Format: postgresql://user:password@host:port/dbname?sslmode=require
# For Vercel Postgres, use the transaction mode pooler URL
DATABASE_URL=postgresql://user:password@host:5432/quantive?sslmode=require

# Personal database (can share the same PostgreSQL instance)
PERSONAL_DATABASE_URL=postgresql://user:password@host:5432/quantive_personal?sslmode=require

# Production settings
ENVIRONMENT=production
SECURE_COOKIES=true
LOG_LEVEL=INFO

# CORS — your Vercel frontend URL (comma-separated for multiple)
CORS_ORIGINS=https://your-app.vercel.app

# Rate limiting
RATE_LIMIT_PER_MINUTE=2000

# ── Stripe (Qubo Tax billing) ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Qubo Tax plan Stripe Price IDs
STRIPE_QUBO_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_QUBO_STARTER_YEARLY_PRICE_ID=price_...
STRIPE_QUBO_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_QUBO_PRO_YEARLY_PRICE_ID=price_...
STRIPE_QUBO_SOVEREIGN_MONTHLY_PRICE_ID=price_...
STRIPE_QUBO_SOVEREIGN_YEARLY_PRICE_ID=price_...

# Platform plan Stripe Price IDs
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_...
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_...

# ── Frontend (Vercel) ──────────────────────────────────────────────
# Set these in the frontend Vercel project
VITE_API_URL=https://your-backend.vercel.app

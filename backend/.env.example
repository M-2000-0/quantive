# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://quantive:quantive@localhost:5432/quantive

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3-compatible storage (MinIO for dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=quantive-reports

# Encryption key (32 hex chars for AES-256)
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-string

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Webhook retry
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY_MS=60000

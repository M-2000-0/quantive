# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
venv/
.venv/

# database
*.db
*.db-shm
*.db-wal
*.sqlite

# runtime logs
logs/

# typescript
*.tsbuildinfo
next-env.d.ts

# tool caches
.freebuff/

# local dev scratch scripts and outputs
/audit_check.py
/check_audit.py
/test_health.py
/test_prov.py
/verify_day4.py
/test_week2.py
/test_week2_detailed.py
